{
  "name": "ogre-next",
  "version": "2.3.0",
  "description": "Ogre 2.3 - scene-oriented, flexible 3D engine written in C++",
  "homepage": "https://github.com/OGRECave/ogre-next",
  "license": "MIT",
  "dependencies": [
    "rapidjson",
    "sdl2",
    "zlib",
    "zziplib",
    "freetype",
    "boost-thread",
    "boost-date-time",
    "boost-system",
    "boost-chrono",
    "boost-atomic",
    "opengl",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "vulkan": {
      "description": "Vulkan render system",
      "dependencies": [
        "vulkan"
      ]
    },
    "d3d11": {
      "description": "d3d11 render system"
    },
    "plugin-pfx": {
      "description": "Build ParticleFX plugin"
    },
    "mesh-lod-generator": {
      "description": "Build MeshLodGenerator component"
    },
    "planar-reflections": {
      "description": "Component to use planar reflections, can be used by both HlmsPbs & HlmsUnlit"
    },
    "overlay": {
      "description": "Build Overlay component"
    },
    "tools": {
      "description": "Build tools"
    },
    "xsi-exporter": {
      "description": "Build the Softimage exporter"
    },
    "samples": {
      "description": "Build samples"
    }
  }
}
